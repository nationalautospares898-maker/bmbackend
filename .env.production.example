#  National Auto Spares — PRODUCTION configuration template
#  =========================================================
#
#  Copy to `.env.production` and fill in. `.env.production` is git-ignored by the
#  `.env.*` rule in `.gitignore`; THIS file is committed and must therefore contain
#  PLACEHOLDERS ONLY (`CLAUDE.md §11`, `SECURITY.md §8`).
#
#  WHAT THIS FILE IS FOR
#  ---------------------
#  Two jobs, and nothing else:
#
#    1. Running `alembic upgrade head` against Neon **from this machine**, which is the
#       documented migration path (ADR-016: migrations are an explicit deploy step and
#       never run on application start).
#    2. Running `scripts/production_db.py` — inspect / verify / provision.
#
#  The Railway API container does **not** read this file. Its variables are set in the
#  Railway dashboard; see `docs/RAILWAY-ENVIRONMENT-VARIABLES.md`. The two lists overlap
#  but are deliberately not identical — most importantly `BM_MIGRATION_DATABASE_URL`
#  belongs here and must never exist in the API container (`CLAUDE.md §11`).
#
#  BUSINESS RULES ARE NOT HERE
#  ---------------------------
#  Tax mode, draft limits, credit terms, discount caps, the cancellation window, the
#  print profile and the date format are database `settings` rows with defaults in
#  `src/bm/domain/settings/defaults.py`, so the owner changes them without a deploy. A
#  fresh database needs **no** settings rows: an unset key uses its documented default.
#
#  HOW TO USE IT SAFELY
#  --------------------
#      ./scripts/prod.ps1 python scripts/production_db.py inspect
#
#  `scripts/prod.ps1` loads this file into the process environment and nothing else does.
#  A bare `alembic upgrade head` reads `.env` — the LOCAL database — because that is what
#  `migrations/env.py::_load_dotenv()` looks for. That is the mistake this whole workflow
#  exists to make impossible; `production_db.py migrate` additionally refuses any target
#  that is not the verified Neon host.


# =============================================================================
#  1. ENVIRONMENT
# =============================================================================

# `production` turns on the production self-checks in `main.py` and makes the refresh
# cookie `Secure` (`api/v1/auth.py`: `secure = env != "local"`).
BM_ENV=production

# The git SHA of the deployed commit. Reported by `GET /api/v1/meta` and attached to
# every alert payload, so a bug report maps to an exact build. On Railway this is
# `${{RAILWAY_GIT_COMMIT_SHA}}`; here, set it by hand or leave it as the tag you migrated
# from.
BM_RELEASE=REPLACE_WITH_GIT_SHA_OR_TAG


# =============================================================================
#  2. NEON DATABASE — the two URLs, and why they are different
# =============================================================================
#
#  Neon gives you two connection strings for the same database. They are not
#  interchangeable:
#
#    DIRECT (….ap-southeast-1.aws.neon.tech)
#        A real Postgres connection. Supports session state, advisory locks, prepared
#        statements and DDL. REQUIRED for Alembic.
#
#    POOLED (…-pooler.ap-southeast-1.aws.neon.tech)
#        PgBouncer in transaction mode. Many short connections, which is what a web API
#        wants. It does NOT support session-level features, and `SET statement_timeout`
#        issued on connect — which `infra/db/session.py` does on every connection — is
#        scoped to the transaction rather than the session.
#
#  Both URLs need `?sslmode=require`. Neon refuses plaintext, and psycopg will not
#  negotiate TLS without being told to.
#
#  Take both from: Neon Console → project `national auto spares` → branch `production`
#  → Connect → role `neondb_owner`, database `neondb` → toggle "Connection pooling".
#
#  Convert the URL Neon shows you (`postgresql://…`) to the driver this project uses by
#  replacing the scheme with `postgresql+psycopg://`. Nothing else changes.

# --- migration role: DDL. Used by Alembic, from this machine only. -----------
#
# MUST be the DIRECT (non-pooler) host. Alembic opens a transaction per migration and
# runs `CREATE EXTENSION`, `CREATE TYPE` and `ALTER TABLE`; PgBouncer in transaction mode
# will not carry that reliably.
#
# This variable must NEVER be set on the Railway service.
BM_MIGRATION_DATABASE_URL=postgresql+psycopg://neondb_owner:REPLACE_PASSWORD@ep-REPLACE-ME.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- application role: DML only. ---------------------------------------------
#
# Set here so `production_db.py verify` can prove the app role really is refused the
# writes the migrations revoke. The value on Railway should be the POOLED URL; see
# `docs/RAILWAY-ENVIRONMENT-VARIABLES.md` for why, and §2.1 below for the pool sizes that
# go with it.
#
# `bm_app` is created by `scripts/neon-init-roles.sql`, which must run BEFORE the
# migrations — the `GRANT`/`REVOKE` statements inside them are guarded by
# `_app_role_exists()` and are silently skipped if the role does not yet exist.
BM_DATABASE_URL=postgresql+psycopg://bm_app:REPLACE_PASSWORD@ep-REPLACE-ME-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- 2.1 pool and timeouts ---------------------------------------------------
#
# Behind PgBouncer the application pool should be small: the pooler is doing the
# multiplexing, and a large client-side pool just holds server connections open against
# Neon's limit. 5 + 2 is ample for one API replica at the design load (5 counters,
# ~500 invoices/day).
BM_DB_POOL_SIZE=5
BM_DB_MAX_OVERFLOW=2

# Unchanged from the defaults. `lock_timeout` is the one that matters at a counter: a
# finalisation that cannot get its stock locks fails fast with a retryable error instead
# of hanging the till while a customer waits.
BM_DB_STATEMENT_TIMEOUT_MS=15000
BM_DB_LOCK_TIMEOUT_MS=3000


# =============================================================================
#  3. SECRETS
# =============================================================================
#
#  All three are 32+ characters, validated at startup. Generate each one SEPARATELY —
#  never reuse one value for two of them:
#
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#
#  Use the SAME values here as on Railway. `production_db.py provision` hashes the owner
#  password with `BM_PASSWORD_PEPPER`, and a hash peppered with a different value
#  authenticates nobody — a failure indistinguishable from a wrong password.

BM_JWT_SIGNING_KEY=REPLACE_WITH_48_BYTE_URLSAFE_TOKEN_MIN_32_CHARS

# Set only during a signing-key rotation overlap (`docs/DEPLOYMENT.md §10`). Leave
# commented otherwise.
# BM_JWT_PREVIOUS_KEY=

# ⚠ PERMANENT. Changing this invalidates every existing password — there is no rotation
# procedure and `docs/DEPLOYMENT.md §10` says so outright. Store it somewhere you will
# still have it in five years.
BM_PASSWORD_PEPPER=REPLACE_WITH_A_DIFFERENT_48_BYTE_URLSAFE_TOKEN

# Rotatable. Old IP hashes become uncorrelatable, which is acceptable.
BM_IP_HASH_PEPPER=REPLACE_WITH_A_THIRD_48_BYTE_URLSAFE_TOKEN

# Defaults. 15-minute access token, 30-day refresh family.
BM_ACCESS_TOKEN_TTL_SECONDS=900
BM_REFRESH_TOKEN_TTL_DAYS=30


# =============================================================================
#  4. HTTP — not used by the migration, listed so this file is a complete record
# =============================================================================

# Explicit comma-separated list of front-end ORIGINS. Scheme + host + port, no path, no
# trailing slash, NEVER a wildcard. CORS middleware is only installed when this is
# non-empty (`main.py`), so on Railway it is effectively mandatory.
BM_CORS_ALLOWED_ORIGINS=https://REPLACE-WITH-YOUR-VERCEL-DOMAIN

# `false` in production. `/api/v1/openapi.json` stays reachable either way — that is the
# contract the front end generates its types from — but the interactive `/docs` page does
# not. `main.py` logs a warning if this is on with `BM_ENV=production`.
BM_ENABLE_API_DOCS=false

# Declared in `config.py` and currently read by nothing — there is no rate limiter in
# `src/`. Login lockout is separate, implemented, and database-backed (5 failures in
# 5 minutes → 15-minute lockout, `domain/auth/service.py`). Left at its default so the
# variable's meaning does not change when a limiter does land.
BM_RATE_LIMIT_ENABLED=true

# ⚠ MUST STAY OFF on anything reachable from the internet. With it on, ANYONE who can
# reach the server gets a working session with no password and no second factor —
# `api/v1/auth.py::unattended` states the risk in full. It is safe only on a machine
# bound to localhost or a LAN the shop owns. `main.py` logs a WARNING on every start
# while it is on so a deployment cannot drift into it unnoticed.
BM_UNATTENDED_ACCESS=false
# BM_UNATTENDED_USERNAME=

# 🔴 THE ONE THAT LOOKS FINE AND THEN SIGNS THE SHOP OUT MID-BILL.
#
# `SameSite` compares the **registrable domain**, and `vercel.app` and `up.railway.app`
# are both public suffixes — so a front end on one and an API on the other are
# **cross-site**, and a `lax` cookie is never sent to `POST /auth/refresh`. Login works,
# everything works, and then every session dies at `BM_ACCESS_TOKEN_TTL_SECONDS`. The
# owner reported this as *"it's logging out after every 13 min and the work I was doing
# was gone"* — 13 and not 15 because the client renews two minutes ahead of expiry, so
# the failure lands on the renewal.
#
# This deployment is that topology (`bmfrontend-seven.vercel.app` +
# `bmbackend-production.up.railway.app`), so it needs `none`. `none` requires a `Secure`
# cookie, which `BM_ENV=production` already sets.
#
# Use `lax` instead **only** if you move to one owned domain (`app.…` + `api.…`,
# topology A) or put the API behind the Vercel proxy (topology C). Full reasoning in
# `config.py` and `docs/PRODUCTION-DEPLOYMENT-GUIDE.md §10.4`; `GET /readyz` now reports
# `checks.refresh_cookie.status` so this is visible instead of silent.
BM_REFRESH_COOKIE_SAMESITE=none


# =============================================================================
#  5. STORAGE
# =============================================================================
#
#  `local` is the only implemented backend. `s3` passes validation but
#  `infra/storage/objects.py` is a filesystem store and `storage_bucket` is an unused
#  seam — setting `s3` would change a log line and nothing else.
#
#  On Railway this path MUST point inside a mounted Volume, or every uploaded price list
#  and purchase file is lost on the next redeploy. Import *rows* survive in the database;
#  the original file does not.
BM_STORAGE_BACKEND=local
BM_STORAGE_PATH=./storage
BM_MAX_UPLOAD_MB=10


# =============================================================================
#  6. OBSERVABILITY
# =============================================================================

BM_LOG_LEVEL=INFO

# `json` in production — one object per line, with request correlation fields, through
# the redaction filter in `infra/logging/setup.py`. `console` is for a human reading a
# terminal.
BM_LOG_FORMAT=json

# Declared in `config.py` and read by nothing: there is no Sentry SDK in
# `pyproject.toml`. Leave unset rather than setting a DSN that goes nowhere.
# BM_SENTRY_DSN=


# =============================================================================
#  7. ALERTING (OD-19 — a go-live gate, not optional)
# =============================================================================
#
#  Off by default, and `/readyz` reports the state either way. Turning it on without a
#  recipient makes every alert an `ERROR` log line that reaches nobody, which
#  `infra/alerting/channel.py` treats as a monitoring outage rather than a warning.
#  OD-19 requires a NAMED person before go-live.
BM_ALERTING_ENABLED=false
# An https:// webhook (Slack / Teams / a pager provider). For most providers the PATH is
# the credential, which is why `/readyz` only ever reports the scheme and host.
# A plain-http webhook is refused outright when BM_ENV=production.
# BM_ALERT_WEBHOOK_URL=
# A person, not a shared inbox. OD-19: "an alert that reaches nobody is not monitoring."
# BM_ALERT_RECIPIENT_NAME=
BM_ALERT_MIN_SEVERITY=warning
BM_ALERT_TIMEOUT_SECONDS=5.0


# =============================================================================
#  8. WORKER
# =============================================================================
#
# Only relevant if a second Railway service runs `python -m bm.worker`. The worker claims
# jobs with `FOR UPDATE SKIP LOCKED`, so multiple workers are already safe; file imports
# are parsed there, so with no worker running an upload is accepted and never processed.
BM_WORKER_CONCURRENCY=2
