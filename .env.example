# Copy to .env for local development. `.env` is git-ignored.
#
# PLACEHOLDERS ONLY. Never commit a real credential, and never paste a production value
# into this file (`CLAUDE.md §11`, `SECURITY.md §8`).
#
# Business rules are NOT here. Tax mode, draft limits, credit terms, discount caps,
# cancellation windows and invoice prefixes are database `settings` rows so the owner
# can change them without a deploy.

# --- environment --------------------------------------------------------------
BM_ENV=local
BM_RELEASE=dev

# --- database -----------------------------------------------------------------
# The application role. NOT the migration role.
BM_DATABASE_URL=postgresql+psycopg://bm_app:CHANGE_ME@localhost:55439/bm
# Migration-step only. Must not be present in the API container.
# BM_MIGRATION_DATABASE_URL=postgresql+psycopg://bm_migrate:CHANGE_ME@localhost:55439/bm
BM_DB_POOL_SIZE=10
BM_DB_MAX_OVERFLOW=5
BM_DB_STATEMENT_TIMEOUT_MS=15000
BM_DB_LOCK_TIMEOUT_MS=3000

# --- auth ---------------------------------------------------------------------
# 32+ characters each. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
BM_JWT_SIGNING_KEY=CHANGE_ME_at_least_32_characters_long_value
# BM_JWT_PREVIOUS_KEY=   # set only during a key rotation overlap
BM_PASSWORD_PEPPER=CHANGE_ME_at_least_32_characters_long_value
BM_IP_HASH_PEPPER=CHANGE_ME_at_least_32_characters_long_value
BM_ACCESS_TOKEN_TTL_SECONDS=900
BM_REFRESH_TOKEN_TTL_DAYS=30

# --- http ---------------------------------------------------------------------
# Explicit list, comma-separated. Never a wildcard.
BM_CORS_ALLOWED_ORIGINS=http://localhost:5173
BM_ENABLE_API_DOCS=true
BM_RATE_LIMIT_ENABLED=true

# --- storage ------------------------------------------------------------------
BM_STORAGE_BACKEND=local
BM_STORAGE_PATH=./storage
# BM_STORAGE_BUCKET=
BM_MAX_UPLOAD_MB=10

# --- observability ------------------------------------------------------------
BM_LOG_LEVEL=INFO
BM_LOG_FORMAT=console
# BM_SENTRY_DSN=

# --- worker -------------------------------------------------------------------
BM_WORKER_CONCURRENCY=2
